[Unit]
Description=npu-voice-to-text: hold-to-talk dictation with Whisper on the Intel NPU
After=graphical-session.target
PartOf=graphical-session.target
# give up after 5 failed starts in 5 minutes instead of retrying forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# Options are read from ~/.config/npu-voice-to-text/options (one per line, written by
# install.sh), see `npu-voice-to-text serve --help`. After editing it:
#   systemctl --user restart npu-voice-to-text
ExecStart=%h/.local/bin/npu-voice-to-text serve
# Intel's NPU userspace driver + compiler, matching the pip OpenVINO version
# (installed by install.sh; distro packages are often too old). install.sh replaces
# this line with the paths it used: LD_LIBRARY_PATH and the XDG_*_HOME directories.
Environment=LD_LIBRARY_PATH=%h/.local/share/npu-voice-to-text/lib
Restart=on-failure
RestartSec=5
# 3 = keyboard access was declined in the GNOME dialog: don't ask again every 5 s
# (re-run install.sh to be asked again)
RestartPreventExitStatus=3
# the very first start compiles the model for the NPU
TimeoutStartSec=600

[Install]
WantedBy=graphical-session.target
